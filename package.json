{
  "name": "netverse",
  "version": "2.1.0",
  "description": "Interactive 3D web-link explorer with a bounded, SSRF-resistant crawler.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test/*.test.js && node test/smoke.js"
  },
  "keywords": [
    "web-crawler",
    "3d-visualization",
    "three.js",
    "graph",
    "network",
    "galaxy"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "express": "^5.2.1",
    "node-fetch": "^2.7.0"
  },
  "overrides": {
    "proxy-addr": "2.0.8",
    "qs": "6.17.1",
    "undici": "7.30.2",
    "body-parser": "2.4.0",
    "path-to-regexp": "8.4.0"
  }
}
